# DATABASE_URL must use the same credentials/db as POSTGRES_* below, and the
# same host port as POSTGRES_PORT. For local dev, a separate DB (e.g.
# agency_dev) is fine — just keep this URL and POSTGRES_DB in sync.
DATABASE_URL="postgresql://agency_app:changeme@localhost:5432/agency_production"
POSTGRES_USER="agency_app"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="agency_production"
# Host port for the Postgres container (the container side is always 5432).
# Override if 5432 is already in use on the host.
POSTGRES_PORT="5432"
AUTH_SECRET="changeme"
# Optional. Auth.js trusts the reverse-proxy host by default (trustHost: true),
# so this is only needed if you still see "UntrustedHost" errors — set it to
# the canonical public origin, e.g. https://example.com
# AUTH_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SITE_URL="http://localhost:3000"
